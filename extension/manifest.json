{
  "manifest_version": 3,
  "key": "",
  "name": "VDH Lite",
  "version": "1.0.0",
  "description": "Detect browser-visible media and hand downloads to a local yt-dlp native host.",
  "homepage_url": "https://github.com/Eujenz/VDH-Lite",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "VDH Lite",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
