{
  "manifest_version": 3,
  "key": "",
  "name": "VDH Lite Custom",
  "version": "0.1.0",
  "description": "A permission-conscious media request detector inspired by Video DownloadHelper architecture.",
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "VDH Lite Custom"
  },
  "background": {
    "service_worker": "src/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "clipboardWrite",
    "downloads",
    "nativeMessaging",
    "scripting",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ]
}
